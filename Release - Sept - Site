  bell: '<path d="M6 10a6 6 0 1 1 12 0c0 3 1 5 2 6H4c1-1 2-3 2-6z"/><path d="M9.5 19a2.5 2.5 0 0 0 5 0"/>',
  calendarX: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/><path d="M9.5 14.5l4 4M13.5 14.5l-4 4"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4M8 14h2M8 17h2M14 14h2M14 17h2"/>',
  chart: '<path d="M4 20V10M11 20V4M18 20v-7"/><path d="M3 20h18"/>',
  activity: '<path d="M3 12h4l2 6 4-14 2 8h6"/>',
