  clockCheck: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 1.8"/>'
};

const TRACK_LABEL = "Site Release";
const SCENES = [{"kind": "intro", "holdMs": 5000, "releaseDate": "September 2026"}, {"kind": "agenda", "items": [{"name": "Non-Consecutive Dates for Site Scheduling", "icon": "calendarX"}, {"name": "Multi-Location and Schedule Blocks", "icon": "mapPin"}, {"name": "Direct Scheduling and Schedule Moves", "icon": "arrowRight"}, {"name": "Schedule Calendar Enhancements", "icon": "calendar"}, {"name": "Role-Based Access", "icon": "lock"}, {"name": "Onboarding Requirements & Activities", "icon": "checklist"}, {"name": "Search & Filtering", "icon": "search"}], "holdMs": 6000, "label": "Agenda"}, {"kind": "agenda", "items": [{"name": "Notifications", "icon": "bell"}, {"name": "Request Calendar: NCD, Multi-Location & Blocks", "icon": "calendar"}, {"name": "Post-Placement Onboarding Review", "icon": "clockCheck"}, {"name": "Reports", "icon": "chart"}, {"name": "Dashboards", "icon": "activity"}, {"name": "Export Personnel List", "icon": "fileExport"}, {"name": "Notes Framework", "icon": "layers"}], "holdMs": 6000, "label": "Agenda"}, {"title": "Non-Consecutive Dates for Site Scheduling", "icon": "calendarX", "headline": "Define the exact dates a placement should run.", "mainText": "Review, modify, or turn off school-requested Non-Consecutive Dates before approving \u2014 or enable them independently and set the dates yourself. Available across Request Review, Direct Slots, Direct Schedules, and Individual/Group edits.", "chips": ["Review & modify requests", "Enable independently", "Across all scheduling workflows"], "images": ["data:image/jpeg;base64,"], "script": "Sites can now define exact attendance dates for a placement instead of relying only on a continuous date range or recurring days of the week. You can review school-requested Non-Consecutive Dates, modify them, add or remove dates, or turn the option off before approving a request \u2014 or enable Non-Consecutive Dates independently and define the dates yourself. This is available across Request Review, Direct Slots, Direct Schedules, and Individual and Group Schedule Edit workflows.", "kind": "feature", "idx": 0, "total": 14, "tcMs": 2200, "detailMs": 7200}, {"title": "Multi-Location and Schedule Blocks", "icon": "mapPin", "headline": "Structure any placement, across any number of locations.", "mainText": "Assign a Primary Location and one or more Additional Locations, with location hierarchy retained. Schedule Blocks divide a placement into distinct periods \u2014 each with its own dates, location, preceptor, and shift \u2014 and parent-level details stay automatically aligned with the blocks.", "chips": ["Primary + Additional Locations", "Schedule Blocks", "Auto-aligned parent details"], "images": ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], "script": "Sites can now manage placements that span multiple locations or different rotation periods within a single placement. A schedule can have a Primary Location and one or more Additional Locations, with the location hierarchy retained throughout. Schedule Blocks let you divide a placement into distinct periods, each with its own dates, location, preceptor, and shift \u2014 configurable during Direct Slot creation, Direct Schedule creation, Request Review, or later from the schedule drawer. Parent-level schedule information continues to summarize the whole placement, and whenever it changes, the related block information stays automatically aligned, with any impacted fields highlighted for review.", "kind": "feature", "idx": 1, "total": 14, "tcMs": 2200, "detailMs": 7200}, {"title": "Direct Scheduling and Schedule Moves", "icon": "arrowRight", "headline": "Complex placements, built directly from the start.", "mainText": "Multi-location assignments and Schedule Blocks are now supported in Direct Slots and Direct Schedules. Use blocks whenever different parts of a placement need different dates, locations, preceptors, or shifts \u2014 across Individual, Group, and ACE schedules.", "chips": ["Direct Slots", "Direct Schedules", "Individual, Group & ACE"], "images": ["data:image/jpeg;base64,"], "script": "Multi-location assignments and Schedule Blocks are now supported across Direct Slots and Direct Schedules, giving sites more flexibility when creating placements directly. You can select a Primary Location and Additional Locations, and use Schedule Blocks whenever different parts of a placement require different dates, locations, preceptors, shifts, or days of the week \u2014 and Schedule Blocks are supported for Individual, Group, and ACE schedules alike.", "kind": "feature", "idx": 2, "total": 14, "tcMs": 2200, "detailMs": 7200}, {"title": "Schedule Calendar Enhancements", "icon": "calendar", "headline": "See every rotation, every location, at a glance.", "mainText": "Additional Locations display alongside the Primary Location, searchable and filterable. Schedules with Schedule Blocks show each block as its own calendar card.", "chips": ["Search by any location", "Block-level calendar cards"], "images": ["data:image/jpeg;base64,", "data:image/jpeg;base64,"], "script": "The Schedule Calendar now provides a much clearer view of group schedules, multi-location placements, and Schedule Blocks. Additional Locations display alongside the Primary Location, and you can search or filter schedules using any associated location. For schedules with Schedule Blocks, each block appears as its own calendar card, based on its own dates, timing, and location.", "kind": "feature", "idx": 3, "total": 14, "tcMs": 2200, "detailMs": 6000}, {"title": "Role-Based Access", "icon": "lock", "headline": "Full context, right-sized access.", "mainText": "Site Admins manage locations and blocks per their access level. Location Coordinators can edit only what's within their scope \u2014 everything else stays visible but read-only.", "chips": ["Site Admin full access", "Coordinator scoped edits", "Out-of-scope = read-only"], "images": ["data:image/jpeg;base64,"], "script": "Multi-Location Scheduling and Schedule Blocks follow your site's existing role-based access controls, so every user sees the full placement context while only editing what they're authorized to manage. Site Admins can view and manage locations and Schedule Blocks according to their access level, while Location Coordinators can edit only the locations within their assigned scope \u2014 anything outside that scope remains fully visible, but read-only, so no one can make changes to a placement they don't own.", "kind": "feature", "idx": 4, "total": 14, "tcMs": 2200, "detailMs": 7200}, {"title": "Onboarding Requirements & Activities", "icon": "checklist", "headline": "Every location's requirements, generated automatically.", "mainText": "Requirements and activities for the Primary and every Additional Location are generated for the schedule, with duplicates generated only once. Regeneration keeps everything aligned as locations change.", "chips": ["Primary + Additional Locations", "No duplicate requirements", "Auto-realigns on change"], "images": [], "script": "Onboarding requirements, ongoing activities, and off-boarding activities are now considered for every location associated with a placement. Requirements and activities configured for the Primary or Additional Locations are all generated for the schedule, with duplicate requirements generated only once when the same item applies to multiple locations \u2014 and whenever locations are added, removed, or changed, the existing regeneration process keeps everything aligned automatically.", "kind": "feature", "idx": 5, "total": 14, "tcMs": 2200, "detailMs": 7200}, {"title": "Search & Filtering", "icon": "search", "headline": "Find any schedule, by any of its locations.", "mainText": "Location Search, Location Filters, and Location Group Filters now consider both Primary and Additional Locations. Preceptor Search accommodates the expanded structure too.", "chips": ["Primary + Additional Locations", "Preceptor Search updated"], "images": ["data:image/jpeg;base64,"], "script": "Site users can now find schedules using any location associated with a placement, rather than only the Primary Location. Location Search, Location Filters, and Location Group Filters all consider both Primary and Additional Locations, and Preceptor Search accommodates preceptors associated through the expanded location or Schedule Block configuration \u2014 all while your existing access permissions continue to control exactly which schedules each user can see.", "kind": "feature", "idx": 6, "total": 14, "tcMs": 2200, "detailMs": 6000}, {"title": "Notifications", "icon": "bell", "headline": "Every notification, fully located.", "mainText": "Schedule emails now show the Primary Location and all Additional Locations, Primary first. Schedule Block and location updates keep using existing notification types.", "chips": ["Primary listed first", "Existing notification types kept"], "images": ["data:image/jpeg;base64,"], "script": "Existing schedule notifications now include complete location information and use all associated locations when determining notification routing. Key schedule emails display the Primary Location and every Additional Location, with the Primary Location listed first. Updates to Schedule Blocks or Additional Locations continue to use the existing Schedule Updated notification, and Non-Consecutive Date changes on pending requests continue to use Request Updated notifications.", "kind": "feature", "idx": 7, "total": 14, "tcMs": 2200, "detailMs": 6000}, {"title": "Request Calendar: NCD, Multi-Location & Schedule Blocks", "icon": "calendar", "headline": "Accurate dates, locations, and blocks \u2014 by request status.", "mainText": "Pending requests show school-requested dates; approved schedules show site-approved dates and locations. Schedule Blocks appear only on their defined dates, with gaps left empty between blocks.", "chips": ["Status-based accuracy", "Schedule Blocks on defined dates", "Detail popup for more info"], "images": ["data:image/jpeg;base64,"], "script": "The Request Calendar now provides a much clearer view of requests and approved schedules that use Non-Consecutive Dates, multiple locations, and Schedule Blocks \u2014 all based on the request's current status. Pending and in-progress requests show the dates requested by the school, while approved requests show the dates approved by the site, including any changes made during review. Schedule Blocks appear only on their defined dates, with the gaps between blocks left empty, and the detail popup provides additional location and scheduling information at a glance.", "kind": "feature", "idx": 8, "total": 14, "tcMs": 2200, "detailMs": 7200}, {"title": "Post-Placement Onboarding Review", "icon": "clockCheck", "headline": "Compliance tracking continues after the placement ends.", "mainText": "Reviewers can approve or reject onboarding documents after the end date. The Date Became Compliant is highlighted whenever compliance happens after placement end.", "chips": ["Review after end date", "Date Became Compliant", "Highlighted in exports"], "images": ["data:image/jpeg;base64,"], "script": "Sites can now continue reviewing onboarding documents even after a placement has ended, giving much greater visibility into post-placement compliance activity. Reviewers can approve or reject onboarding documents after the placement end date, and the Date Became Compliant clearly shows when compliance was actually achieved. Any compliance or requirement approval dates that fall after the placement end date are highlighted in the Schedule List and Onboarding Details \u2014 and the Date Became Compliant is also available in Schedule List exports.", "kind": "feature", "idx": 9, "total": 14, "tcMs": 2200, "detailMs": 7200}, {"title": "Reports", "icon": "chart", "headline": "Location clarity, built into every report.", "mainText": "Primary and Additional Locations display together with their hierarchy. Impacted reports flag Schedule Blocks and Non-Consecutive Dates.", "chips": ["Primary + Additional Locations", "Schedule Blocks flagged", "Non-Consecutive Dates flagged"], "images": ["data:image/jpeg;base64,"], "script": "Reports now provide much clearer visibility into schedules involving Primary and Additional Locations, while preserving the existing location hierarchy you already rely on. Additional Locations are displayed together with their applicable hierarchy, and impacted reports identify Schedule Blocks and Non-Consecutive Dates wherever they apply \u2014 with location search, filtering, and exports all reflecting the updated multi-location information.", "kind": "feature", "idx": 10, "total": 14, "tcMs": 2200, "detailMs": 7200}, {"title": "Dashboards", "icon": "activity", "headline": "Recent activity, clean and consistent.", "mainText": "Primary Location shows first, Additional Locations roll into +N more. Group or Individual now leads every activity description.", "chips": ["Primary Location first", "+N more indicator"], "images": ["data:image/jpeg;base64,"], "script": "Recent Activities across the site dashboards now display location and schedule information in a much more concise and consistent format. The Primary Location appears first, while Additional Locations are represented using a simple plus-N-more indicator \u2014 hovering reveals the complete location hierarchy \u2014 and Group or Individual now appears at the very beginning of each schedule-related activity description.", "kind": "feature", "idx": 11, "total": 14, "tcMs": 2200, "detailMs": 6000}, {"title": "Export Personnel List", "icon": "fileExport", "headline": "A real-time personnel export, whenever you need it.", "mainText": "Includes identity, contact, role, location, discipline, and account audit details. Reflects your current grid view, filters, and sorting.", "chips": ["Identity & contact", "Role, location, discipline", "Filters & sorting reflected"], "images": ["data:image/jpeg;base64,"], "script": "Sites can now export the Personnel List as a real-time report, giving you a current view of your personnel information outside Exxat One whenever you need it. The export includes identity, contact, address, access, role, location, discipline, and account audit information, and it reflects your current grid view, including any applied filters, search, and sorting \u2014 right down to personnel status, system access, account activity dates, and NPI where available.", "kind": "feature", "idx": 12, "total": 14, "tcMs": 2200, "detailMs": 7200}, {"title": "Notes Framework", "icon": "layers", "headline": "Capture what matters, right on the request or schedule.", "mainText": "Add Internal Notes for your team, or Shared Notes visible to Schools, Students, and Clinical Instructors. Request-level notes carry forward to the schedule once approved.", "chips": ["Internal Notes", "Shared Notes", "Carries forward on approval"], "images": ["data:image/jpeg;base64,"], "script": "With the Notes Framework, sites can capture and manage important information at both the Request and Schedule levels. You can add Internal Notes for your own team's collaboration, or Shared Notes for information that needs to be visible to Schools, Students, and Clinical Instructors. Request-level notes carry forward to the corresponding schedule once the request is approved, and authorized users can add, edit, or delete notes based on their permissions.", "kind": "feature", "idx": 13, "total": 14, "tcMs": 2200, "detailMs": 7200}, {"kind": "closing", "headline": "Explore the full release in Exxat One", "holdMs": 5000}];

(function(){
  const sceneRoot = document.getElementById('sceneRoot');
  const persistLabel = document.getElementById('persistLabel');
  const watermark = document.getElementById('watermark');
  const stageProgress = document.getElementById('stageProgress');
  const trackBar = document.getElementById('trackBar');
  const counter = document.getElementById('counter');
  const playBtn = document.getElementById('playBtn');
  const playIcon = document.getElementById('playIcon');
  const pauseIcon = document.getElementById('pauseIcon');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');

  let current = -1;
  let playing = false;
  let started = false;
  let progressTimer = null;
  let progressStart = 0;
  let sceneTimers = [];
  let sceneToken = 0;

  function buildTrackBar(){
    trackBar.innerHTML = '';
    SCENES.forEach((s,i) => {
      const seg = document.createElement('div');
      seg.className = 'seg';
      const fill = document.createElement('div');
      fill.className = 'fill';
      seg.appendChild(fill);
      seg.addEventListener('click', () => { hardStop(); playScene(i); });
      trackBar.appendChild(seg);
    });
  }
  function segs(){ return Array.from(trackBar.children); }
  function setSegDone(upToExclusive){
    segs().forEach((seg,i) => {
      const fill = seg.querySelector('.fill');
      if (i < upToExclusive){ seg.classList.add('done'); fill.style.width='100%'; }
      else if (i > upToExclusive){ seg.classList.remove('done'); fill.style.width='0%'; }
    });
  }
  function setCurrentSegProgress(pct){
    const seg = segs()[current];
    if (!seg) return;
    seg.classList.remove('done');
    seg.querySelector('.fill').style.width = pct + '%';
  }
  function animateProgress(duration){
    clearInterval(progressTimer);
    progressStart = Date.now();
    progressTimer = setInterval(() => {
      const elapsed = Date.now() - progressStart;
      setCurrentSegProgress(Math.min(100, (elapsed/duration)*100));
    }, 80);
  }

  function clearSceneTimers(){ sceneTimers.forEach(t => clearTimeout(t)); sceneTimers = []; }
  function after(ms, fn){ const t = setTimeout(fn, ms); sceneTimers.push(t); return t; }
  function every(ms, fn){ const t = setInterval(fn, ms); sceneTimers.push(t); return t; }

  function hardStop(){
    sceneToken++;
    clearInterval(progressTimer);
    clearSceneTimers();
  }

  function updatePlayIcon(){
    playIcon.style.display = playing ? 'none' : 'block';
    pauseIcon.style.display = playing ? 'block' : 'none';
  }

  function holdThenAdvance(ms, myToken){
    animateProgress(ms);
    after(ms, () => { if (myToken === sceneToken) advance(); });
  }

  function advance(){
    if (!playing) return;
    if (current < SCENES.length - 1){ playScene(current + 1); }
    else { playing = false; updatePlayIcon(); counter.textContent = 'Teaser complete — press play to replay'; }
  }

  function renderIntro(scene, myToken){
    sceneRoot.innerHTML = '<div class="intro-wrap">' +
      '<img class="intro-emblem" id="ie" src="data:image/png;base64,">' +
      '<div class="intro-line1" id="il1">Exxat One</div>' +
      '<div class="intro-line2" id="il2">Release Teaser &bull; Release Highlights</div>' +
      '<div class="intro-line3" id="il3">' + TRACK_LABEL + '</div>' +
      '<div class="intro-date" id="il4">' + (scene.releaseDate||'') + '</div>' +
      '</div>';
    after(50, () => document.getElementById('ie').classList.add('on'));
    after(500, () => document.getElementById('il1').classList.add('on'));
    after(1000, () => document.getElementById('il2').classList.add('on'));
    after(1500, () => document.getElementById('il3').classList.add('on'));
    after(1900, () => document.getElementById('il4').classList.add('on'));
    holdThenAdvance(scene.holdMs, myToken);
  }

  function renderAgenda(scene, myToken){
    const cards = scene.items.map((it,i) =>
      '<div class="agenda-card" data-i="'+i+'"><svg viewBox="0 0 24 24">'+(ICONS[it.icon]||ICONS.checklist)+'</svg><span>'+it.name+'</span></div>'
    ).join('');
    sceneRoot.innerHTML = '<div class="agenda-wrap">' +
      '<div class="agenda-head"><h2>What\'s New in Exxat One</h2><small>' + TRACK_LABEL + '</small></div>' +
      '<div class="agenda-grid" id="agrid">' + cards + '</div>' +
      '</div>';
    const cardEls = Array.from(document.querySelectorAll('#agrid .agenda-card'));
    cardEls.forEach((el,i) => {
      after(150 + i*180, () => {
        el.classList.add('on');
        el.classList.add('pulse');
        after(320, () => el.classList.remove('pulse'));
      });
    });
    const totalReveal = 150 + cardEls.length*180 + 500;
    holdThenAdvance(Math.max(scene.holdMs||0, totalReveal), myToken);
  }

  function renderFeature(scene, idx, total, myToken){
    sceneRoot.innerHTML =
      '<div class="titlecard-wrap" id="tcWrap">' +
        '<div class="tc-mark">Exxat One</div>' +
        '<div class="tc-rule"></div>' +
        '<div class="tc-title">' + scene.title + '</div>' +
        '<div class="tc-sub">' + TRACK_LABEL + '</div>' +
        '<div class="tc-idx">' + String(idx+1).padStart(2,'0') + ' / ' + String(total).padStart(2,'0') + '</div>' +
      '</div>' +
      '<div class="detail-wrap" id="dtWrap">' +
        '<div class="detail-visual" id="dVisual"></div>' +
        '<div class="detail-text">' +
          '<h3 class="dt-title" id="dTitle">' + scene.title + '</h3>' +
          '<p class="dt-headline" id="dHeadline">' + (scene.headline||'') + '</p>' +
          '<p class="dt-main" id="dMain">' + scene.mainText + '</p>' +
          '<div class="dt-chips" id="dChips"></div>' +
        '</div>' +
      '</div>';

    const visual = document.getElementById('dVisual');
    if (scene.images && scene.images.length){
      visual.innerHTML = '<div class="shot-frame" id="shotFrame"><div class="shot-stack" id="shotStack">' +
        scene.images.map((src,i) => '<img src="'+src+'" class="'+(i===0?'on':'')+'">').join('') +
        '</div></div>';
    } else {
      visual.innerHTML = '<div class="icon-card" id="iconCard"><svg viewBox="0 0 24 24">'+(ICONS[scene.icon]||ICONS.checklist)+'</svg><div class="ic-label">'+scene.title+'</div></div>';
    }

    document.getElementById('tcWrap').classList.add('on');

    const TC_HOLD = scene.tcMs || 2200;
    animateProgress(TC_HOLD);
    after(TC_HOLD, () => {
      document.getElementById('tcWrap').classList.remove('on');
      document.getElementById('dtWrap').classList.add('on');
      const frame = document.getElementById('shotFrame');
      const card = document.getElementById('iconCard');
      after(80, () => { if (frame) frame.classList.add('on'); if (card) card.classList.add('on'); });
      if (scene.images && scene.images.length > 1){
        let ci = 0;
        const cyc = setInterval(() => {
          const stack = document.getElementById('shotStack');
          if (!stack) { clearInterval(cyc); return; }
          const imgs = stack.querySelectorAll('img');
          imgs[ci].classList.remove('on');
          ci = (ci+1) % imgs.length;
          imgs[ci].classList.add('on');
          if (frame){ frame.classList.add('flash'); setTimeout(()=>frame && frame.classList.remove('flash'), 500); }
        }, 3600);
        sceneTimers.push(cyc);
      }
      after(300, () => document.getElementById('dTitle').classList.add('on'));
      after(600, () => document.getElementById('dHeadline').classList.add('on'));
      after(950, () => document.getElementById('dMain').classList.add('on'));
      const chips = scene.chips || [];
      const chipWrap = document.getElementById('dChips');
      const chipGap = 1200;
      chips.forEach((c,i) => {
        const el = document.createElement('span');
        el.className = 'dt-chip';
        el.textContent = c;
        chipWrap.appendChild(el);
        after(1400 + i*chipGap, () => {
          el.classList.add('on');
          const frame2 = document.getElementById('shotFrame');
          if (frame2){ frame2.classList.add('flash'); after(450, () => frame2.classList.remove('flash')); }
        });
      });
      const detailMs = scene.detailMs || (1400 + chips.length*chipGap + 2200);
      holdThenAdvance(detailMs, myToken);
    });
  }

  function renderClosing(scene, myToken){
    sceneRoot.innerHTML = '<div class="closing-wrap" id="clWrap">' +
      '<h1>' + scene.headline + '</h1>' +
      '<img src="data:image/png;base64," alt="Exxat One">' +
      '<button class="replay-btn" id="replayBtn">Watch again</button>' +
      '</div>';
    after(80, () => document.getElementById('clWrap').classList.add('on'));
    document.getElementById('replayBtn').addEventListener('click', () => {
      hardStop(); playing = true; updatePlayIcon(); playScene(0);
    });
    holdThenAdvance(scene.holdMs, myToken);
  }

  function playScene(i){
    hardStop();
    sceneToken++;
    const myToken = sceneToken;
    if (i < 0) i = 0;
    if (i > SCENES.length - 1) i = SCENES.length - 1;
    current = i;
    const scene = SCENES[i];
    setSegDone(current);
    setCurrentSegProgress(0);
    counter.textContent = scene.kind === 'feature' ? scene.title : (scene.label || '');

    if (scene.kind === 'feature'){
      persistLabel.classList.add('show');
      watermark.classList.add('show');
      stageProgress.classList.add('show');
      stageProgress.textContent = String(scene.idx+1).padStart(2,'0') + ' / ' + String(scene.total).padStart(2,'0');
    } else {
      persistLabel.classList.add('show');
      watermark.classList.add('show');
      stageProgress.classList.remove('show');
    }

    if (scene.kind === 'intro') renderIntro(scene, myToken);
    else if (scene.kind === 'agenda') renderAgenda(scene, myToken);
    else if (scene.kind === 'feature') renderFeature(scene, scene.idx, scene.total, myToken);
    else if (scene.kind === 'closing') renderClosing(scene, myToken);
  }

  function beginPlayback(){
    started = true;
    playing = true;
    updatePlayIcon();
    playScene(0);
  }

  playBtn.addEventListener('click', () => {
    if (!started){ beginPlayback(); return; }
    playing = !playing;
    updatePlayIcon();
    if (playing){
      if (current >= 0) playScene(current);
    } else {
      hardStop();
    }
  });
  prevBtn.addEventListener('click', () => { if(!started) return; hardStop(); playScene(current - 1); });
  nextBtn.addEventListener('click', () => { if(!started) return; hardStop(); playScene(current + 1); });
  document.addEventListener('keydown', (e) => {
    if (!started) return;
    if (e.key === 'ArrowRight'){ hardStop(); playScene(current+1); }
    if (e.key === 'ArrowLeft'){ hardStop(); playScene(current-1); }
    if (e.key === ' '){ e.preventDefault(); playBtn.click(); }
  });

  buildTrackBar();
  beginPlayback();
})();
</script>
</body>
</html>
