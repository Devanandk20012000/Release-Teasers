      </div>
      <div class="counter" id="counter">Press play to begin</div>
    </div>
  </div>
</div>

<script>
const ICONS = {
  mapPin: '<path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.4"/>',
  layers: '<path d="M12 3 2 8l10 5 10-5-10-5z"/><path d="M2 13l10 5 10-5"/><path d="M2 18l10 5 10-5"/>',
  checklist: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h6M7 13h10M7 17h10"/><path d="M17 8l1.2 1.2L20 7.4"/>',
