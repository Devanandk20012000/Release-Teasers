  clockCheck: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 1.8"/>'
};

const TRACK_LABEL = "School Release";
const SCENES = [{"kind": "intro", "holdMs": 5000, "releaseDate": "September 2026"}, {"kind": "agenda", "items": [{"name": "Multi-Location and Schedule Blocks", "icon": "mapPin"}, {"name": "Non-Consecutive Dates for Slot Requests", "icon": "calendarX"}, {"name": "Onboarding Requirements & Activities", "icon": "checklist"}, {"name": "Search & Filtering", "icon": "search"}, {"name": "Notifications", "icon": "bell"}, {"name": "Schedule Calendar Enhancements", "icon": "calendar"}, {"name": "Reports", "icon": "chart"}, {"name": "Activities Dashboard", "icon": "activity"}, {"name": "Notes Framework", "icon": "layers"}], "holdMs": 6000, "label": "Agenda"}, {"title": "Multi-Location and Schedule Blocks", "icon": "mapPin", "headline": "Manage complex placements across locations and rotation periods.", "mainText": "See every location tied to a placement \u2014 Primary and Additional \u2014 with full location hierarchy retained. Schedule Blocks break multi-period placements into distinct rotations, each with its own dates, location, preceptor, and shift.", "chips": ["Primary Location", "Additional Locations", "Schedule Blocks", "List / Calendar View"], "images": ["data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"], "script": "Multi-Location and Schedule Blocks give schools a complete view of complex placements. You'll see every location tied to a placement \u2014 the Primary Location and any Additional Locations \u2014 with the full location hierarchy retained. For placements with multiple rotation periods, Schedule Blocks break things down clearly, each with its own dates, location, preceptor, and shift, viewable in List or Calendar view.", "kind": "feature", "idx": 0, "total": 9, "tcMs": 2200, "detailMs": 8400}, {"title": "Non-Consecutive Dates for Slot Requests", "icon": "calendarX", "headline": "Request exact attendance dates, not just a date range.", "mainText": "Enable Non-Consecutive Dates on a slot request and select the exact days a student